# Frontend (Vercel) environment — copy to .env.local for local dev.

# Express backend base URL:
#   https://<service-name>.onrender.com  (or https://api.blieve.in once mapped)
NEXT_PUBLIC_API_URL=https://blieve-api.onrender.com

# Canonical public site URL (sitemap/robots/Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.blieve.in
