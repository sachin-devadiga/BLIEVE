# Copy to .env.local for local development and add these in Vercel: Settings → Environment Variables.

# MongoDB connection string (Atlas: Database → Connect → Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true

# Optional database name (defaults to "blieve")
MONGODB_DB_NAME=blieve

# Protects member sessions (HMAC-signed httpOnly cookie). Use a long random string.
SESSION_SECRET=replace-with-a-long-random-string

# Password that unlocks the admin review console at /admin and /api/admin/*
ADMIN_PASSWORD=replace-with-a-long-random-string

# Displayed for the admin session on dashboards
ADMIN_NAME=Administrator
ADMIN_EMAIL=president@blieve.in

# Canonical site URL used by sitemap/robots/O tags (defaults to https://www.blieve.in)
NEXT_PUBLIC_SITE_URL=https://www.blieve.in
