# Copy to .env for local development. Set the same variables in Render: Environment → Environment Variables.

PORT=4000

# MongoDB Atlas connection string (Database → Connect → Drivers → Node.js)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true

# Optional database name (defaults to "blieve")
MONGODB_DB_NAME=blieve

# Secret used to sign member session cookies (long random string)
SESSION_SECRET=replace-with-a-long-random-string

# Password that unlocks the admin review console (/api/admin/login, /admin page)
ADMIN_PASSWORD=replace-with-a-long-random-string

# Shown for the admin session on dashboards
ADMIN_NAME=Administrator
ADMIN_EMAIL=president@blieve.in

# Frontend origins allowed to call this API (comma-separated)
CORS_ORIGINS=https://www.blieve.in,https://blieve.in,http://localhost:3000
